{
  "name": "@baharat-sort/app",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "node ../prototype/build.mjs && expo start",
    "ios": "node ../prototype/build.mjs && expo start --ios",
    "game": "node ../prototype/build.mjs",
    "typecheck": "node ../prototype/build.mjs > /dev/null && tsc -p tsconfig.json --noEmit",
    "testflight": "node ../prototype/build.mjs && eas build --platform ios --profile production --auto-submit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.14",
    "expo-constants": "~58.0.12",
    "expo-haptics": "~58.0.7",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "expo-tracking-transparency": "~58.0.2",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-google-mobile-ads": "17.2.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2"
  }
}
